# ==============================================================================
# Sales Forecast Automator - Environment Configuration Example
# Copy this file to .env or export these variables in your shell / container.
#
# NOTE: This application uses 100% synthetic data for hackathon demonstrations.
# Never store real credentials, production API keys, or live data in .env files.
# ==============================================================================

# Server Network Configuration (Default: 127.0.0.1 for local security)
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# SQLite Database Location
DATABASE_URL=sqlite:///./data/forecast.db

# Automated Scheduler Configuration (24-hour format HH:MM)
SCHEDULE_RUN_TIME=06:00
SCHEDULE_ENABLED=true

# Sales Cloud System of Record (SoR) Integration
# When SALES_CLOUD_ENABLED is false, MockSalesCloudClient provides seeded synthetic SoR data.
SALES_CLOUD_ENABLED=false
SALES_CLOUD_API_URL=https://api.salescloud.mock.internal/v1
SALES_CLOUD_CLIENT_ID=mock_client_id
SALES_CLOUD_CLIENT_SECRET=mock_client_secret

# Reconciliation Governance
RECONCILIATION_TOLERANCE_USD=0.01
BLOCK_ON_MISMATCH=false
